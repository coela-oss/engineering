{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coela interface lifecycle definition v1",
  "description": "Bounded JSON object leaf projection coverage and change planning; native validation and execution authority remain external.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "interfaces"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "native_sources",
          "identity",
          "fields",
          "consumers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "owner": {
            "type": "string",
            "pattern": "^https://github.com/[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$"
          },
          "native_sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_.-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "identity": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 180,
              "pattern": "^/(?:[^~]|~[01])+$"
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 180,
                  "pattern": "^/(?:[^~]|~[01])+$"
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "owner",
                "fields"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "owner": {
                  "type": "string",
                  "pattern": "^https://github.com/[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "native_sources": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 200,
                        "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_.-]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "support"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 180,
                        "pattern": "^/(?:[^~]|~[01])+$"
                      },
                      "support": {
                        "enum": [
                          "required",
                          "optional",
                          "excluded"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
