{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coela knowledge unit — candidate authoring envelope",
  "description": "A candidate for identity, presentation and immutable source composition. Not a semantic language, plugin manifest, HAT package or runtime adoption record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "kind", "owner", "default_locale", "presentation", "sources"],
  "properties": {
    "schema_version": { "const": "coela-knowledge-unit/1-candidate" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "kind": { "enum": ["guidance", "case-study", "procedure"] },
    "owner": { "$ref": "#/$defs/repository" },
    "default_locale": { "$ref": "#/$defs/locale" },
    "presentation": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["locale", "title", "summary"],
        "properties": {
          "locale": { "$ref": "#/$defs/locale" },
          "title": { "$ref": "#/$defs/text" },
          "summary": { "$ref": "#/$defs/text" }
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "reference"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["guidance", "procedure", "evidence", "case-study", "presentation", "semantic-source"] },
          "locale": { "$ref": "#/$defs/locale" },
          "reference": {
            "oneOf": [
              { "$ref": "#/$defs/catalogSelection" },
              { "$ref": "#/$defs/artifact" }
            ]
          }
        }
      }
    },
    "related_units": {
      "description": "Navigation links only; no semantic dependency or authorization is inferred.",
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "$ref": "#/$defs/version" },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "locale": { "enum": ["en", "ja"] },
    "repository": { "type": "string", "maxLength": 256, "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "pointer": { "type": "string", "maxLength": 1024, "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
    "text": {
      "oneOf": [
        {
          "description": "Text authored here once. Translations are separate reviewed localizations.",
          "type": "object", "additionalProperties": false, "required": ["value"],
          "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" } }
        },
        {
          "description": "Select an existing string from a pinned JSON source; do not copy it into this envelope.",
          "type": "object", "additionalProperties": false, "required": ["source_id", "pointer"],
          "properties": { "source_id": { "$ref": "#/$defs/id" }, "pointer": { "$ref": "#/$defs/pointer" } }
        }
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository", "revision", "path", "sha256", "media_type"],
      "properties": {
        "kind": { "const": "artifact" },
        "repository": { "$ref": "#/$defs/repository" },
        "revision": { "$ref": "#/$defs/revision" },
        "path": { "type": "string", "maxLength": 512, "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "media_type": { "enum": ["application/json", "text/markdown", "text/plain"] }
      }
    },
    "catalogSelection": {
      "description": "Existing Engineering Selection inside an immutable source checkout reference; v1 catalog bytes are unchanged.",
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository", "revision", "selection"],
      "properties": {
        "kind": { "const": "catalog-selection" },
        "repository": { "const": "https://github.com/coela-oss/engineering" },
        "revision": { "$ref": "#/$defs/revision" },
        "selection": {
          "type": "object", "additionalProperties": false,
          "required": ["catalogId", "version", "catalogSha256", "contentId", "contentSha256"],
          "properties": {
            "catalogId": { "const": "coela-engineering-content" },
            "version": { "$ref": "#/$defs/version" },
            "catalogSha256": { "$ref": "#/$defs/digest" },
            "contentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
            "contentSha256": { "$ref": "#/$defs/digest" }
          }
        }
      }
    }
  }
}
